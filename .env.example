# Public site. Copy this file to .env.local and fill in real values there.
# Never commit secrets. Never put the service role key in a NEXT_PUBLIC_ variable.

# Canonical practice host. elvisfrancoismd.com redirects here.
CANONICAL_HOST=thealignmentclinic.com
CANONICAL_ORIGIN=https://thealignmentclinic.com

# Comma-separated hosts that 301 to CANONICAL_ORIGIN, path preserved.
REDIRECT_HOSTS=elvisfrancoismd.com,www.elvisfrancoismd.com,www.thealignmentclinic.com

# Leave false until launch. Preview deployments are also noindex.
INDEXING_ENABLED=false

# file: public pages read the repository drafts' publish rules.
# supabase: public clinical pages read published rows. Do not flip this until RLS is applied.
CONTENT_SOURCE=file

# Optional administrative inbox. The contact form still does not store or send the note
# until a separate approved delivery channel exists. Do not use this for medical information.
CONTACT_INBOX=

# Supabase. The anon key is public by design and is constrained by row level security.
# The service role key bypasses RLS. Server-only. Never expose it to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Outside-records OCR (staff Patients desk). Calls Clinix clinix-ocr Cloud Run.
# Server-only. Do not expose OCR_SERVICE_KEY to the browser.
OCR_SERVICE_URL=
OCR_SERVICE_KEY=
# Optional. Defaults to 180000.
# OCR_SERVICE_TIMEOUT_MS=180000

# Used to mine OCR text into a chart draft (same key as coding/scribe paths).
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
